PORT=3000
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h
DATABASE_PATH=./data/pluglytics.db

# Hosting (see docs/pilot/deployment.md)
# Number of reverse proxies in front of the app. Set to 1 on Render. Leave 0 locally.
TRUST_PROXY=0
# Where `npm run backup` writes copies, and how many to keep. Default: a backups/ folder next to the database, 7 copies.
BACKUP_DIR=
BACKUP_KEEP=7

# --- Canvas LTI 1.3 (see docs/pilot/canvas-lti-install.md) ---
# Tool private key: run `npm run lti:keygen` and paste the line it prints. Keep it secret.
LTI_PRIVATE_KEY=
# Public address of this server, for example https://pluglytics.xyz
LTI_TOOL_URL=
# From the Canvas developer key (Client ID) and the installed app (Deployment ID). Launches are refused until both are set.
LTI_CLIENT_ID=
LTI_DEPLOYMENT_IDS=
# Defaults are for Instructure-hosted Canvas. Change them for a self-hosted, beta or test Canvas.
LTI_ISSUER=https://canvas.instructure.com
LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks
# Roles linked to a PlugLytics account by email on first launch. Admins are linked with `npm run lti:link`.
LTI_EMAIL_LINK_ROLES=student,instructor
# Sites allowed to show PlugLytics in a frame. Needed for Canvas, for example https://*.instructure.com
FRAME_ANCESTORS=

# --- Stellar merchant credentials ---
# NEVER commit real keys. Copy this file to .env (which is git-ignored) and fill in real values there.
# Which environment to use: "sandbox" (Stellar testnet) or "production" (Stellar public network)
STELLAR_ENV=sandbox

# Optional overrides. If left empty, the defaults for the selected STELLAR_ENV are used.
STELLAR_HORIZON_URL=
STELLAR_NETWORK_PASSPHRASE=

# Sandbox (testnet): Horizon https://horizon-testnet.stellar.org
SANDBOX_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SANDBOX_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SANDBOX_MERCHANT_PUBLIC_KEY=GPLACEHOLDER_SANDBOX_PUBLIC_KEY
SANDBOX_MERCHANT_SECRET_KEY=SPLACEHOLDER_SANDBOX_SECRET_KEY
SANDBOX_WEBHOOK_SIGNING_SECRET=PLACEHOLDER_SANDBOX_WEBHOOK_SECRET

# Production (public network): Horizon https://horizon.stellar.org
PRODUCTION_STELLAR_HORIZON_URL=https://horizon.stellar.org
PRODUCTION_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
PRODUCTION_MERCHANT_PUBLIC_KEY=GPLACEHOLDER_PRODUCTION_PUBLIC_KEY
PRODUCTION_MERCHANT_SECRET_KEY=SPLACEHOLDER_PRODUCTION_SECRET_KEY
PRODUCTION_WEBHOOK_SIGNING_SECRET=PLACEHOLDER_PRODUCTION_WEBHOOK_SECRET

# --- Payment policy ---
# Every value below is a placeholder. TODO: group decision.
# See "Payment policy settings" in docs/stellar/payments-api.md.

# Where exchange-rate quotes come from. Only "manual" exists so far. TODO: group decision.
PAYMENT_RATE_SOURCE=manual

# Manual rates: PAYMENT_MANUAL_RATE_<CURRENCY>_<ASSET> = asset units per 1 unit of the currency.
# These are made-up TESTNET rates, not market prices. If no PAYMENT_MANUAL_RATE_ line is set,
# these same test rates are used. TODO: group decision.
PAYMENT_MANUAL_RATE_USD_XLM=2.5000000
PAYMENT_MANUAL_RATE_PHP_XLM=0.0430000

# Minimum and maximum amount of one payment request, per asset, in that asset.
# Leave empty for no limit. TODO: group decision.
XLM_MIN_AMOUNT=
XLM_MAX_AMOUNT=
USDC_MIN_AMOUNT=
USDC_MAX_AMOUNT=

# Days after a payment during which a customer can ask for a refund (1 to 3650).
# Leave empty until decided: refunds must not run without it. TODO: group decision.
REFUND_WINDOW_DAYS=

# Refunds above this amount (per asset, in that asset) need a second admin's approval.
# Leave empty until decided. TODO: group decision.
REFUND_APPROVAL_THRESHOLD_XLM=
REFUND_APPROVAL_THRESHOLD_USDC=

# Whether this server may send (issue) refund payments: true or false. Default false.
# Requesting, approving and rejecting refunds work either way. Set it to true only on
# a server that should send testnet refunds; keep it false on the public demo.
REFUND_ISSUING_ENABLED=false

# Approved anchors: comma-separated home domains, for example anchor.example.com.
# Empty = no anchors approved. TODO: group decision.
APPROVED_ANCHORS=
